/* ==========================================================
   PAC-MAN DO INFERNO
   Labirinto estilo Pac-Man. O jogador come pontos/almas.
   Quatro demônios têm comportamentos diferentes.
   O objetivo é limpar o mapa e/ou pegar a saída após a
   quantidade mínima de almas. O mapa é estável para permitir
   aprender o caminho, mas os demônios perseguem de verdade.
   ========================================================== */
function inferno(){
 clearAll();S.hells++;save();
 const W=31,H=23,T=28;
 const raw=[
 "###############################",
 "#P...........................#",
 "#.#####.#######.#######.#####.#",
 "#.#.....#.....#.#.....#.....#.#",
 "#.#.###.#.###.#.#.###.#.###.#.#",
 "#...#...#...#...#...#...#...#.#",
 "###.#.#####.#####.#####.#####.#",
 "#...#.....#.....#.....#.....#.#",
 "#.#######.#####.#.#####.#######",
 "#.........#.....#.....#.........#",
 "#########.#.#########.#.########",
 "#.........#.....E.....#.........#",
 "#########.#.#########.#.########",
 "#.........#.....#.....#.........#",
 "#.#######.#####.#.#####.#######",
 "#...#.....#.....#.....#.....#...#",
 "###.#.#####.#####.#####.#####.###",
 "#...#...#...#...#...#...#...#.#",
 "#.#.###.#.###.#.#.###.#.###.#.#",
 "#.#.....#.....#.#.....#.....#.#",
 "#.#####.#######.#######.#####.#",
 "#.............................#",
 "###############################"
 ];
 // Corrige dimensões e cria pontos em todas as passagens.
 let grid=raw.map(r=>r.padEnd(W,"#").slice(0,W));
 let player={x:1,y:1,dx:1,dy:0},exit={x:15,y:11};
 let pellets=new Set();
 for(let y=0;y<H;y++)for(let x=0;x<W;x++)if(grid[y][x]!=="#")pellets.add(x+","+y);
 pellets.delete("1,1");pellets.delete(exit.x+","+exit.y);
 // Quatro caçadores.
 let demons=[
  {x:29,y:1,mode:"chase",color:"#ff3650"},
  {x:1,y:21,mode:"ambush",color:"#a36cff"},
  {x:29,y:21,mode:"random",color:"#ff9b42"},
  {x:15,y:11,mode:"chase",color:"#54e6e2"}
 ];
 let collected=0,total=pellets.size,time=120,dead=false,ready=true;
 const MIN=Math.min(35,total);
 document.getElementById("app").innerHTML=`<div class="screen"><div class="wrap"><section class="card game">
 <div class="head"><div><span class="tag">INFERNO — PAC-MAN</span><h2>FUGA DOS DEMÔNIOS</h2>
 <p>As almas espalhadas pelo labirinto são seus pontos. Colete pelo menos <b>${MIN}</b> e chegue ao portal verde. Os demônios nunca param de perseguir você.</p></div></div>
 <div class="notice">❤️ Vidas anteriores: 0 • 🔥 Almas: <b id="ps">0/${MIN}</b> • ⏱️ <b id="pt">${time}</b>s</div>
 <canvas id="pac" width="${W*T}" height="${H*T}"></canvas>
 <div class="controls"><span class="blank"></span><button onclick="pacMove(0,-1)">▲</button><span class="blank"></span>
 <button onclick="pacMove(-1,0)">◀</button><button onclick="pacMove(0,1)">▼</button><button onclick="pacMove(1,0)">▶</button></div>
 <div class="notice">💻 Computador: setas/WASD • 📱 Celular: botões • <b>Não encoste nos demônios.</b></div>
 </section></div></div>`;
 const canvas=document.getElementById("pac"),ctx=canvas.getContext("2d");
 let lastEnemy=0,frame=0;

 function walk(x,y){return x>=0&&x<W&&y>=0&&y<H&&grid[y][x]!=="#"}
 function dist(a,b){return Math.abs(a.x-b.x)+Math.abs(a.y-b.y)}
 function neighbors(o){
  return [[1,0],[-1,0],[0,1],[0,-1]].filter(([dx,dy])=>walk(o.x+dx,o.y+dy));
 }
 function nextStep(d,index){
  let ns=neighbors(d);if(!ns.length)return [0,0];
  if(d.mode==="random"&&Math.random()<.55)return ns[Math.floor(Math.random()*ns.length)];
  // Ambush mira algumas casas à frente do jogador.
  let target={x:player.x,y:player.y};
  if(d.mode==="ambush"){target.x+=player.dx*4;target.y+=player.dy*4}
  ns.sort((a,b)=>{
   let A={x:d.x+a[0],y:d.y+a[1]},B={x:d.x+b[0],y:d.y+b[1]};
   return dist(A,target)-dist(B,target);
  });
  // Evita voltar diretamente quando possível, criando perseguição mais natural.
  return ns[0];
 }
 function moveEnemies(){
  demons.forEach((d,i)=>{
   let s=nextStep(d,i);d.x+=s[0];d.y+=s[1];
  });
 }
 function collision(){return demons.some(d=>d.x===player.x&&d.y===player.y)}
 function draw(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle="#020106";ctx.fillRect(0,0,canvas.width,canvas.height);
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){
   if(grid[y][x]==="#"){ctx.fillStyle="#190712";ctx.fillRect(x*T,y*T,T,T);ctx.strokeStyle="#461322";ctx.strokeRect(x*T+1,y*T+1,T-2,T-2)}
  }
  pellets.forEach(k=>{let [x,y]=k.split(",").map(Number);ctx.fillStyle="#ffc75a";ctx.beginPath();ctx.arc(x*T+T/2,y*T+T/2,2.5,0,Math.PI*2);ctx.fill()});
  // portal
  ctx.fillStyle=collected>=MIN?"#59e391":"#31503c";ctx.fillRect(exit.x*T+4,exit.y*T+4,T-8,T-8);
  ctx.fillStyle="#111";ctx.font="bold 11px sans-serif";ctx.fillText("E",exit.x*T+8,exit.y*T+16);
  // demons
  demons.forEach(d=>{
   ctx.fillStyle=d.color;ctx.beginPath();ctx.arc(d.x*T+T/2,d.y*T+T/2,T*.38,Math.PI,0);ctx.lineTo(d.x*T+T*.88,d.y*T+T*.82);ctx.lineTo(d.x*T+T*.62,d.y+T*.65);ctx.lineTo(d.x*T+T*.4,d.y+T*.82);ctx.lineTo(d.x*T+T*.12,d.y+T*.65);ctx.closePath();ctx.fill();
   ctx.fillStyle="#fff";ctx.fillRect(d.x*T+7,d.y*T+7,5,5);ctx.fillRect(d.x*T+T-12,d.y*T+7,5,5);
   ctx.fillStyle="#111";ctx.fillRect(d.x*T+8,d.y*T+8,3,3);ctx.fillRect(d.x*T+T-11,d.y*T+8,3,3);
  });
  // Pac-man
  let angle=0;
  if(player.dx>0)angle=0;else if(player.dx<0)angle=Math.PI;else if(player.dy<0)angle=-Math.PI/2;else if(player.dy>0)angle=Math.PI/2;
  let mouth=.25+Math.abs(Math.sin(frame/5))*.25;
  ctx.fillStyle="#ffd23f";ctx.beginPath();ctx.moveTo(player.x*T+T/2,player.y*T+T/2);ctx.arc(player.x*T+T/2,player.y*T+T/2,T*.38,angle+mouth,angle+Math.PI*2-mouth);ctx.closePath();ctx.fill();
 }
 function lose(){
  if(dead)return;dead=true;clearAll();
  document.getElementById("app").innerHTML=`<div class="screen"><div class="wrap"><section class="card result">
   <div class="big">👹</div><h2>VOCÊ FOI PEGO</h2><p>Os demônios encontraram sua alma no Inferno.</p>
   <p>Você não ganhou as 7 vidas. A jornada terminou.</p>
   <button class="btn danger" onclick="home()">VOLTAR AO MENU</button>
  </section></div></div>`;
 }
 function escape(){
  if(dead)return;dead=true;clearAll();S.lives=7;S.score+=500;S.souls+=7;save();
  document.getElementById("app").innerHTML=`<div class="screen"><div class="wrap"><section class="card result">
   <div class="big">🔥</div><span class="tag">VOCÊ SOBREVIVEU AO INFERNO</span><h2>OS DEMÔNIOS FICARAM PARA TRÁS</h2>
   <p>Você escapou do labirinto estilo Pac-Man.</p><p><b>+7 VIDAS</b> • +500 pontos • +7 almas</p>
   <button class="btn primary" onclick="render()">VOLTAR À PROVA</button>
  </section></div></div>`;
 }
 window.pacMove=(dx,dy)=>{
  if(dead)return;
  player.dx=dx;player.dy=dy;
  let nx=player.x+dx,ny=player.y+dy;
  if(!walk(nx,ny)){sound(75,.03);return}
  player.x=nx;player.y=ny;
  pellets.delete(nx+","+ny);collected=total-pellets.size;
  document.getElementById("ps").textContent=collected+"/"+MIN;
  sound(280,.025);
  moveEnemies();
  if(collision()){lose();return}
  if(player.x===exit.x&&player.y===exit.y&&collected>=MIN){escape();return}
  draw();
 };
 document.onkeydown=e=>{
  let m={ArrowUp:[0,-1],ArrowDown:[0,1],ArrowLeft:[-1,0],ArrowRight:[1,0],w:[0,-1],s:[0,1],a:[-1,0],d:[1,0]};
  if(m[e.key]){e.preventDefault();pacMove(...m[e.key])}
 };
 player.dx=1;player.dy=0;draw();
 timer=setInterval(()=>{time--;let t=document.getElementById("pt");if(t)t.textContent=time;if(time<=0)lose()},1000);
 function loop(){if(!dead){frame++;draw();raf=requestAnimationFrame(loop)}}loop();
}

