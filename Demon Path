<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#030208">
<title>Demon Path — Inferno</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;background:#030208;color:#f7eef7;font-family:system-ui,-apple-system,Segoe UI,sans-serif;min-height:100%;overflow-x:hidden}
body{background:radial-gradient(circle at 50% -10%,#48101d,#09050d 40%,#020205)}
button{font:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}
#app{min-height:100vh}
.wrap{width:min(1120px,94%);margin:auto}
.card{background:linear-gradient(145deg,#160d19ee,#08050cee);border:1px solid #ffffff12;border-radius:22px;box-shadow:0 20px 70px #000b}
.screen{min-height:100vh;display:grid;place-items:center;padding:18px}
.hero{padding:clamp(25px,5vw,60px);display:grid;grid-template-columns:1.2fr .8fr;gap:30px;align-items:center}
h1{font-size:clamp(3.5rem,9vw,7rem);line-height:.82;margin:12px 0;background:linear-gradient(#fff,#ff737d,#a10f28);-webkit-background-clip:text;color:transparent}
h2{font-size:clamp(1.7rem,4vw,3rem);margin:5px 0 10px}
h3{margin:8px 0}
p{color:#c8bdca;line-height:1.6}
.tag{display:inline-block;color:#ffca66;background:#ffca6612;border:1px solid #ffca6633;padding:5px 9px;border-radius:99px;font-size:.7rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
.quote{border-left:3px solid #f32e49;padding-left:15px}
.btn{border:1px solid #ffffff18;background:#ffffff08;color:#fff;padding:12px 16px;border-radius:12px;font-weight:800}
.btn:hover{transform:translateY(-1px)}
.primary{background:linear-gradient(135deg,#ff3550,#9e1028);border-color:#ff6070}
.gold{background:linear-gradient(135deg,#ffd36d,#9c5d14);color:#180c03}
.danger{background:#5e0d1d}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
.art{text-align:center;font-size:clamp(9rem,20vw,15rem);filter:drop-shadow(0 0 30px #ef274b);animation:float 3s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-12px)}}

.top{position:sticky;top:0;z-index:10;background:#030208e8;border-bottom:1px solid #ffffff0b;backdrop-filter:blur(12px);padding:10px 0}
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}
.stat{text-align:center;background:#ffffff06;border:1px solid #ffffff0d;border-radius:12px;padding:8px 3px}
.stat b{display:block}.stat span{font-size:.62rem;color:#918693;text-transform:uppercase}
.progress{height:7px;background:#ffffff0b;border-radius:20px;margin-top:9px;overflow:hidden}.progress i{display:block;height:100%;background:linear-gradient(90deg,#f32e49,#ffc45c);transition:.3s}
.campaign{padding:14px 0 40px}
.stages{display:grid;grid-template-columns:repeat(10,1fr);gap:5px;margin:10px 0}
.stage{min-height:55px;border:1px solid #ffffff0c;background:#ffffff04;border-radius:10px;text-align:center;padding:6px;color:#716975;font-size:.65rem}
.stage b{display:block;font-size:1rem}.stage.active{color:#fff;border-color:#ff3850;background:#ff385012}.stage.done{color:#58df91;border-color:#58df9140}
.game{padding:clamp(18px,4vw,32px)}
.head{display:flex;justify-content:space-between;gap:15px;margin-bottom:18px}.head p{margin:3px 0}
.notice{background:#ffffff05;border:1px solid #ffffff10;border-radius:12px;padding:12px;margin:12px 0;color:#c9becb}
.options{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.option,.tile{background:#ffffff06;color:#fff;border:1px solid #ffffff12;border-radius:13px;padding:15px;text-align:left;font-weight:800}
.option:hover,.tile:hover{border-color:#ff4057;background:#ff314d0d}
.choice{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.good{border-color:#55df91!important;background:#55df9114!important}.bad{border-color:#ff3450!important;background:#ff345014!important}
.result{text-align:center;padding:30px}.big{font-size:5rem}
.memory{display:grid;grid-template-columns:repeat(6,1fr);gap:9px}
.mem{aspect-ratio:1;border-radius:12px;border:1px solid #ffffff14;background:linear-gradient(145deg,#30111a,#09060d);color:transparent;font-size:clamp(1.5rem,5vw,2.4rem);display:grid;place-items:center;font-weight:900}
.mem.show,.mem.open,.mem.matched{color:#fff}.mem.show{border-color:#ffca66;background:#3b2814}.mem.open{border-color:#e52c48}.mem.matched{border-color:#59df91;background:#102219}
.word{text-align:center;font-size:clamp(1.8rem,6vw,3.3rem);font-weight:900;letter-spacing:.18em;margin:20px 0}
.keyboard{display:grid;grid-template-columns:repeat(9,1fr);gap:6px}.key{padding:11px 4px;border:1px solid #ffffff12;background:#ffffff06;color:#fff;border-radius:8px;font-weight:800}.key:disabled{opacity:.25}
.board{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;width:min(390px,100%);margin:20px auto}.cell{aspect-ratio:1;background:#ffffff05;border:1px solid #ffffff12;border-radius:12px;color:#fff;font-size:clamp(2.5rem,12vw,5rem);font-weight:900}.cell.x{color:#ff4b61}.cell.o{color:#9582ff}
.case{background:#ffffff04;border:1px solid #ffffff10;padding:15px;border-radius:13px}.case li{margin:8px 0;color:#c7bdc9}
.strategy{display:grid;grid-template-columns:1fr 1fr;gap:10px}.property{border:1px solid #ffffff10;background:#ffffff05;padding:16px;border-radius:13px}
.bar{height:7px;background:#ffffff0b;border-radius:99px;overflow:hidden}.bar i{display:block;height:100%;background:#ffc45c}
canvas{display:block;width:100%;max-width:1100px;margin:auto;border:1px solid #ffffff15;border-radius:14px;background:#020106}
.controls{display:grid;grid-template-columns:repeat(3,64px);gap:7px;justify-content:center;margin:12px auto}.controls button{width:64px;height:54px;border:1px solid #ffffff16;background:#ffffff08;color:#fff;border-radius:12px;font-size:1.3rem;font-weight:900}.blank{visibility:hidden}
.footer{text-align:center;color:#665d68;font-size:.7rem;margin-top:15px}
@media(max-width:800px){.hero{grid-template-columns:1fr}.art{font-size:8rem}.stages{grid-template-columns:repeat(5,1fr)}}
@media(max-width:600px){.screen{padding:10px}.options,.strategy{grid-template-columns:1fr}.memory{grid-template-columns:repeat(4,1fr)}.keyboard{grid-template-columns:repeat(7,1fr)}.choice{grid-template-columns:1fr 1fr}.stats{gap:4px}.stat{padding:7px 1px}.stat span{font-size:.5rem}}

/* ===== TELA INICIAL: DEMON PATH ===== */
#titleScreen{
  position:fixed;
  inset:0;
  z-index:9999;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  background:
    radial-gradient(circle at 50% 75%, rgba(255,70,0,.24), transparent 28%),
    radial-gradient(circle at 20% 20%, rgba(120,0,0,.30), transparent 30%),
    linear-gradient(180deg,#070307 0%,#160207 48%,#050204 100%);
  color:#fff;
}
#titleScreen::before{
  content:"";
  position:absolute;
  inset:-20%;
  background:
    radial-gradient(ellipse at 50% 100%, rgba(255,80,0,.20), transparent 35%),
    repeating-linear-gradient(105deg, transparent 0 70px, rgba(255,40,0,.035) 71px 74px);
  animation:infernalGlow 5s ease-in-out infinite alternate;
}
#titleScreen::after{
  content:"";
  position:absolute;
  left:0; right:0; bottom:0;
  height:42%;
  background:linear-gradient(to top,rgba(0,0,0,.82),transparent);
  pointer-events:none;
}
@keyframes infernalGlow{
  from{transform:scale(1) rotate(-1deg);opacity:.65}
  to{transform:scale(1.08) rotate(1deg);opacity:1}
}
.titleCard{
  position:relative;
  z-index:2;
  width:min(760px,90vw);
  padding:42px 28px 34px;
  text-align:center;
  border:1px solid rgba(255,90,30,.35);
  border-radius:24px;
  background:rgba(8,4,7,.72);
  box-shadow:0 0 70px rgba(255,45,0,.18), inset 0 0 45px rgba(120,0,0,.12);
  backdrop-filter:blur(8px);
}
.titleEyebrow{
  margin-bottom:8px;
  font-size:13px;
  letter-spacing:6px;
  color:#ff8b5a;
  text-transform:uppercase;
}
.gameTitle{
  margin:0;
  font-size:clamp(38px,8vw,78px);
  line-height:.95;
  letter-spacing:3px;
  font-weight:900;
  color:#fff;
  text-shadow:0 0 8px #ff3b00,0 0 28px rgba(255,50,0,.65),0 5px 0 #570b05;
}
.gameSubtitle{
  margin:15px 0 26px;
  color:#d7c7c7;
  font-size:15px;
  letter-spacing:1px;
}
.soulMark{
  width:76px;height:76px;
  margin:0 auto 18px;
  border-radius:50% 50% 45% 45%;
  background:radial-gradient(circle at 45% 35%,#fff 0 7%,#bff8ff 14%,#6ce9ff 35%,rgba(69,175,255,.35) 58%,transparent 72%);
  filter:drop-shadow(0 0 18px #55dcff);
  animation:soulFloat 2.2s ease-in-out infinite;
}
@keyframes soulFloat{
  0%,100%{transform:translateY(0) scale(1)}
  50%{transform:translateY(-8px) scale(1.05)}
}
.startButton{
  appearance:none;
  border:0;
  cursor:pointer;
  padding:16px 52px;
  border-radius:999px;
  color:#fff;
  font-size:19px;
  font-weight:900;
  letter-spacing:2px;
  background:linear-gradient(180deg,#ff5a1f,#b81308);
  box-shadow:0 8px 30px rgba(255,45,0,.35), inset 0 1px rgba(255,255,255,.25);
  transition:transform .15s ease,filter .15s ease;
}
.startButton:hover{transform:translateY(-2px) scale(1.02);filter:brightness(1.12)}
.startButton:active{transform:translateY(1px) scale(.98)}
.instructions{
  margin:25px auto 0;
  max-width:570px;
  padding:16px 18px;
  border-radius:15px;
  background:rgba(255,255,255,.045);
  border:1px solid rgba(255,255,255,.08);
  color:#d8d1d1;
  font-size:14px;
  line-height:1.6;
}
.instructions strong{color:#ff9b73}
.hint{margin-top:12px;color:#9d9696;font-size:12px}
#titleScreen.hide{
  animation:screenOut .45s ease forwards;
}
@keyframes screenOut{
  to{opacity:0;transform:scale(1.03);visibility:hidden}
}

</style>
</head>
<body>

<div id="titleScreen">
  <div class="titleCard">
    <div class="titleEyebrow">UM CAMINHO SEM VOLTA</div>
    <div class="soulMark" aria-hidden="true"></div>
    <h1 class="gameTitle">DEMON PATH</h1>
    <div class="gameSubtitle">SOUL ESCAPE</div>
    <button class="startButton" id="startGameButton">▶ JOGAR</button>
    <div class="instructions">
      <strong>👻 VOCÊ É UMA ALMA.</strong><br>
      Atravesse o caminho infernal, enfrente os demônios e encontre a saída.
      Os demônios se movimentam em tempo real — mesmo quando você fica parado.
      <br><br>
      <strong>🎮 CONTROLES:</strong> use as setas do teclado ou os controles na tela.
      <div class="hint">Colete o que encontrar, evite os demônios e sobreviva.</div>
    </div>
  </div>
</div>

<div id="app"></div>
<script>
"use strict";

/* ==========================================================
   DEMON PATH v3
   10 provas lineares.
   Quando as 4 vidas acabam: Pac-Man do Inferno.
   Se escapar: ganha 7 vidas e volta para a prova.
   ========================================================== */

const SAVE="DEMON_PATH_V3";
const STAGES=[
 ["Julgamento","Quiz com respostas embaralhadas.","quiz"],
 ["Paradoxo","Sequências e lógica sob pressão.","logic"],
 ["Memória dos Mortos","Observe por 2 segundos. Depois encontre os pares.","memory"],
 ["A Palavra Proibida","Descubra a palavra antes do carrasco.","hangman"],
 ["O Último Detetive","Cruze as pistas e descubra o culpado.","detective"],
 ["Olhos do Abismo","Encontre as anomalias.","errors"],
 ["Duelo da Alma","O demônio joga perfeitamente.","ttt"],
 ["Tabuleiro Infernal","Damas com captura e perseguição.","checkers"],
 ["Fortuna Maldita","Faça a estratégia certa em 7 dias.","market"],
 ["Porta da Morte","Chegue ao portal e conclua a jornada.","maze"]
];
const Q=[
["Qual componente executa instruções?",["CPU","RAM","SSD","Monitor"],0],
["Qual estrutura usa LIFO?",["Pilha","Fila","Grafo","Árvore"],0],
["1010 em binário é:",["10","8","12","5"],0],
["2^10 é:",["1024","512","2048","1000"],0],
["Qual camada OSI trata roteamento?",["Rede","Física","Sessão","Apresentação"],0],
["Qual protocolo é usado para páginas web?",["HTTP","SMTP","FTP","BIOS"],0],
["3 máquinas fazem 3 peças em 3 min. 100 máquinas fazem 100 peças em:",["3 min","100 min","33 min","1 min"],0],
["Machu Picchu foi construída pelos:",["Incas","Romanos","Egípcios","Maias"],0],
["Capital do Brasil antes de Brasília:",["Rio de Janeiro","Salvador","São Paulo","Recife"],0],
["Mitologia: deus do mar grego:",["Poseidon","Hades","Hermes","Ares"],0],
["Usina de energia da célula:",["Mitocôndria","Núcleo","Ribossomo","Lisossomo"],0],
["O que é uma vulnerabilidade?",["Uma fraqueza explorável","Um antivírus","Uma memória","Uma placa"],0],
["O que HTTPS adiciona ao HTTP?",["Segurança/criptografia","Mais RAM","Bluetooth","Compressão obrigatória"],0],
["Qual algoritmo tende a crescer O(n²)?",["Laços aninhados","Constante","Logaritmo","Busca binária sempre"],0],
["Nenhum A é B. Todo C é A. C pode ser B?",["Não","Sim","Sempre","Somente se C=0"],0]
];
const WORDS=["VULNERABILIDADE","CRIPTOGRAFIA","PERSISTENCIA","CONSCIENCIA","LABIRINTO","NECROMANCIA","ALGORITMO","SOBRENATURAL","PROGRAMACAO"];

let S=load(),timer=null,raf=null;

function base(){return{stage:0,lives:7,souls:0,score:0,combo:0,hells:0,finished:false}}
function load(){try{return Object.assign(base(),JSON.parse(localStorage.getItem(SAVE))||{})}catch(e){return base()}}
function save(){localStorage.setItem(SAVE,JSON.stringify(S))}
function clearAll(){clearInterval(timer);cancelAnimationFrame(raf);timer=null;raf=null}
function reset(){if(confirm("Apagar todo o progresso e começar novamente?")){S=base();save();home()}}
function sound(f=220,d=.06){try{let C=window.audio||(window.audio=new(window.AudioContext||window.webkitAudioContext)()),o=C.createOscillator(),g=C.createGain();o.frequency.value=f;o.type="square";g.gain.value=.025;o.connect(g);g.connect(C.destination);o.start();g.gain.exponentialRampToValueAtTime(.0001,C.currentTime+d);o.stop(C.currentTime+d)}catch(e){}}

function home(){
 clearAll();
 document.getElementById("app").innerHTML=`<div class="screen"><div class="wrap"><section class="card hero">
 <div><span class="tag">ENTRE A VIDA E O INFERNO</span><h1>DEMON<br>PATH</h1>
 <p class="quote">Você sofreu um acidente. Seu corpo está entre a vida e a morte. Você foi uma pessoa ruim e agora precisa provar que merece voltar.</p>
 <p>Complete todas as provas em sequência. Se perder suas vidas, será jogado em um <b>Pac-Man do Inferno</b>. Escapar dos demônios lhe dará <b>7 novas vidas</b>.</p>
 <div class="actions"><button class="btn primary" onclick="start()">⚔️ ${S.stage?"CONTINUAR":"COMEÇAR"}</button><button class="btn" onclick="story()">📜 HISTÓRIA</button><button class="btn danger" onclick="reset()">☠️ NOVO JOGO</button></div></div>
 <div class="art">💀</div></section></div></div>`;
}
function story(){
 document.getElementById("app").innerHTML=`<div class="screen"><div class="wrap"><section class="card game" style="text-align:center">
 <span class="tag">PRÓLOGO</span><h2>O Julgamento</h2>
 <p>O acidente apagou o som do mundo. Quando você abriu os olhos, estava em um corredor que não existia.</p>
 <p>Uma voz disse: <b>“Você quer voltar? Então atravesse as provas.”</b></p>
 <p>Cada desafio será mais difícil. Seus erros custarão vidas. Quando as vidas acabarem, os demônios virão atrás de você.</p>
 <div class="actions" style="justify-content:center"><button class="btn primary" onclick="start()">ACEITAR</button><button class="btn" onclick="home()">VOLTAR</button></div>
 </section></div></div>`;
}
function start(){sound(90,.12);render()}
function shell(body){
 let pct=Math.round(S.stage/STAGES.length*100);
 return `<div class="top"><div class="wrap"><div class="stats">
 <div class="stat"><b>❤️ ${S.lives}</b><span>Vidas</span></div><div class="stat"><b>🔥 ${S.souls}</b><span>Almas</span></div>
 <div class="stat"><b>✦ ${S.score}</b><span>Pontos</span></div><div class="stat"><b>⚔️ ${S.combo}</b><span>Combo</span></div>
 <div class="stat"><b>${Math.min(S.stage+1,10)}/10</b><span>Prova</span></div></div><div class="progress"><i style="width:${pct}%"></i></div></div></div>
 <main class="campaign"><div class="wrap"><div class="stages">${STAGES.map((x,i)=>`<div class="stage ${i===S.stage?"active ":""}${i<S.stage?"done":""}"><b>${i<S.stage?"✓":i+1}</b>${x[0]}</div>`).join("")}</div>
 <section class="card game">${body}</section><div class="footer">DEMON PATH • Sem atalhos • Sem facilidade</div></div></main>`;
}
function render(){
 clearAll();
 if(S.stage>=10){S.finished=true;save();victory();return}
 let x=STAGES[S.stage];
 document.getElementById("app").innerHTML=shell(`<div class="head"><div><span class="tag">PROVA ${S.stage+1}</span><h2>${x[0]}</h2><p>${x[1]}</p></div><button class="btn" onclick="home()">MENU</button></div><div id="game"></div>`);
 window["g_"+x[2]]();
}
function fail(msg){
 clearAll();S.lives--;S.combo=0;save();sound(70,.22);
 if(S.lives<=0){inferno();return}
 document.getElementById("game").innerHTML=`<div class="result"><div class="big">☠️</div><h2>${msg}</h2><p>Você perdeu uma vida. Restam <b>${S.lives}</b>.</p><button class="btn primary" onclick="render()">TENTAR NOVAMENTE</button></div>`;
}
function pass(points){
 clearAll();S.stage++;S.lives=Math.max(S.lives,1);S.combo++;S.souls++;S.score+=points+S.combo*15;save();sound(500,.08);setTimeout(()=>sound(800,.1),80);
 if(S.stage>=10){S.finished=true;save();victory();return}
 document.getElementById("game").innerHTML=`<div class="result"><div class="big">✦</div><h2>VOCÊ PASSOU</h2><p>Uma porta se abriu. A próxima prova será ainda mais difícil.</p><button class="btn primary" onclick="render()">PRÓXIMA PROVA</button></div>`;
}

/* ---------------- QUIZ ---------------- */
function g_quiz(){
 let arr=[...Q].sort(()=>Math.random()-.5).slice(0,8),i=0;
 const game=document.getElementById("game");
 function draw(){
  if(i===arr.length){pass(180);return}
  let q=arr[i],opts=q[1].map((v,n)=>[v,n]).sort(()=>Math.random()-.5);
  game.innerHTML=`<div class="notice">Questão ${i+1}/8 • Você precisa acertar todas.</div><h3>${q[0]}</h3><div class="options">${opts.map(o=>`<button class="option" onclick="qa(${o[1]})">${o[0]}</button>`).join("")}</div>`;
  window.qa=n=>{if(n===q[2]){i++;sound(450);draw()}else fail("Resposta errada.")};
 }
 draw();
}

/* ---------------- LOGIC ---------------- */
function g_logic(){
 const P=[
  ["2, 6, 12, 20, 30, ?",["40","42","44","48"],1],
  ["1, 1, 2, 3, 5, 8, ?",["11","12","13","15"],2],
  ["3, 9, 27, 81, ?",["162","243","324","729"],1],
  ["5, 10, 20, 40, ?",["60","70","80","100"],2],
  ["81, 27, 9, 3, ?",["1","0","2","-3"],0]
 ].sort(()=>Math.random()-.5);
 let i=0;
 function draw(){let p=P[i];document.getElementById("game").innerHTML=`<div class="notice">Paradoxo ${i+1}/5</div><h3>${p[0]}</h3><div class="options">${p[1].map((x,n)=>`<button class="option" onclick="la(${n})">${x}</button>`).join("")}</div>`}
 window.la=n=>{if(n===P[i][2]){i++;i===P.length?pass(210):draw()}else fail("O paradoxo derrotou sua lógica.")};
 draw();
}

/* ---------------- MEMORY: 2 SEC REVEAL ---------------- */
function g_memory(){
 const symbols=["☠","👁","🩸","🔥","🕷","🦇","⛓","🗝","⚰","🌑","🕯","👿"];
 let cards=[...symbols,...symbols].sort(()=>Math.random()-.5);
 let open=[],matches=0,moves=0,locked=true,time=45;
 const game=document.getElementById("game");
 game.innerHTML=`<div class="notice" id="memNotice">⚠️ MEMORIZE! Todas as cartas ficarão visíveis por <b>2 segundos</b>. Decore a posição de cada símbolo.</div><div class="memory" id="memGrid">${cards.map((s,i)=>`<button class="mem show" data-i="${i}">${s}</button>`).join("")}</div>`;
 const els=[...document.querySelectorAll(".mem")];
 setTimeout(()=>{
  els.forEach(e=>{e.textContent="";e.classList.remove("show")});
  locked=false;
  document.getElementById("memNotice").innerHTML=`🧠 Agora começou! Encontre os <b>12 pares</b>. Tempo: <b id="mt">${time}</b>s • Máximo: 35 movimentos.`;
  timer=setInterval(()=>{time--;let t=document.getElementById("mt");if(t)t.textContent=time;if(time<=0)fail("Sua memória falhou antes do tempo acabar.")},1000);
 },2000);
 els.forEach(e=>e.onclick=()=>flip(+e.dataset.i));
 function flip(i){
  if(locked||open.includes(i)||els[i].classList.contains("matched"))return;
  els[i].textContent=cards[i];els[i].classList.add("open");open.push(i);moves++;sound(240,.04);
  if(open.length===2){
   locked=true;let [a,b]=open;
   if(cards[a]===cards[b]){
    els[a].classList.add("matched");els[b].classList.add("matched");matches++;open=[];locked=false;
    if(matches===symbols.length)pass(260);
   }else setTimeout(()=>{els[a].textContent="";els[b].textContent="";els[a].classList.remove("open");els[b].classList.remove("open");open=[];locked=false},500);
  }
  if(moves>35)fail("Você gastou movimentos demais.");
 }
}

/* ---------------- HANGMAN ---------------- */
function g_hangman(){
 let word=WORDS[Math.floor(Math.random()*WORDS.length)],used=new Set(),wrong=0,max=5;
 function draw(){
