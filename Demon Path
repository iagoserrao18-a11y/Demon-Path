/* ---------------- TTT PERFECT ---------------- */
function g_ttt(){
 let b=Array(9).fill(""),over=false;
 const game=document.getElementById("game");
 function win(p){return [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]].some(a=>a.every(i=>b[i]===p))}
 function mm(isMax,d){
  if(win("O"))return 10-d;if(win("X"))return d-10;if(b.every(Boolean))return 0;
  let best=isMax?-Infinity:Infinity;
  for(let i=0;i<9;i++)if(!b[i]){b[i]=isMax?"O":"X";let v=mm(!isMax,d+1);b[i]="";best=isMax?Math.max(best,v):Math.min(best,v)}
  return best;
 }
 function draw(){game.innerHTML=`<div class="notice">Você é X. O demônio é O. A IA joga com minimax.</div><div class="board">${b.map((x,i)=>`<button class="cell ${x.toLowerCase()}" onclick="tp(${i})">${x}</button>`).join("")}</div>`}
 window.tp=i=>{
  if(over||b[i])return;b[i]="X";if(win("X")){over=true;pass(290);return}
  if(b.every(Boolean)){over=true;fail("Empate não vale. O demônio exige vitória.");return}
  let best=-Infinity,m=-1;for(let j=0;j<9;j++)if(!b[j]){b[j]="O";let v=mm(false,0);b[j]="";if(v>best){best=v;m=j}}
  b[m]="O";if(win("O")){over=true;fail("O demônio venceu o duelo.");return}if(b.every(Boolean)){over=true;fail("O demônio bloqueou todas as suas saídas.");return}draw()
 };draw();
}

/* ---------------- CHECKERS ---------------- */
function g_checkers(){
 const N=6;let b=Array.from({length:N},()=>Array(N).fill(""));
 for(let r=0;r<2;r++)for(let c=0;c<N;c++)if((r+c)%2)b[r][c]="d";
 for(let r=4;r<N;r++)for(let c=0;c<N;c++)if((r+c)%2)b[r][c]="p";
 let sel=null,turn="p",moves=0;
 const game=document.getElementById("game");
 function legal(r,c,p){
  let ds=p==="p"?[[-1,-1],[-1,1]]:[[1,-1],[1,1]],a=[];
  for(let [dr,dc] of ds){let y=r+dr,x=c+dc;
   if(y>=0&&y<N&&x>=0&&x<N&&!b[y][x])a.push([y,x,false]);
   else if(y>=0&&y<N&&x>=0&&x<N&&b[y][x]&&b[y][x]!==p){let yy=y+dr,xx=x+dc;if(yy>=0&&yy<N&&xx>=0&&xx<N&&!b[yy][xx])a.push([yy,xx,true])}
  }return a;
 }
 function all(p){let a=[];for(let r=0;r<N;r++)for(let c=0;c<N;c++)if(b[r][c]===p)for(let m of legal(r,c,p))a.push({f:[r,c],t:m});return a}
 function draw(){game.innerHTML=`<div class="notice">🔴 Você • ⚫ Demônio • Movimento ${moves}/35</div><div class="board" style="grid-template-columns:repeat(6,1fr);width:min(450px,100%)">${b.flatMap((row,r)=>row.map((x,c)=>`<button class="cell" style="font-size:clamp(1.3rem,7vw,2.7rem);background:${(r+c)%2?"#35101a":"#100a12"}" onclick="cp(${r},${c})">${sel&&sel[0]===r&&sel[1]===c?"◆":x==="p"?"🔴":x==="d"?"⚫":""}</button>`)).join("")}</div>`}
 function ai(){
  let a=all("d");if(!a.length){pass(310);return}a.sort((x,y)=>(y.t[2]?100:0)-(x.t[2]?100:0));let m=a[0],[r,c]=m.f,[y,x]=m.t;b[y][x]="d";b[r][c]="";if(x!==c&&y!==r)b[(r+y)/2][(c+x)/2]="";turn="p"
 }
 window.cp=(r,c)=>{
  if(turn!=="p")return;
  if(sel){let [sr,sc]=sel,m=legal(sr,sc,"p").find(x=>x[0]===r&&x[1]===c);
   if(m){b[r][c]="p";b[sr][sc]="";if(m[2])b[(sr+r)/2][(sc+c)/2]="";moves++;sel=null;if(!all("d").length){pass(310);return}turn="d";draw();setTimeout(()=>{ai();draw()},250);return}
   sel=null;draw();return
  }
  if(b[r][c]==="p"){sel=[r,c];draw()}
 };
 draw();
}

